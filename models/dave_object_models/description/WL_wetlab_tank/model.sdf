<?xml version="1.0"?>
<sdf version="1.9">
  <model name="wl_tank">
    <static>true</static>

    <link name="tank">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>meshes/wetlab_tank.glb</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>meshes/wetlab_tank.glb</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <link name="water_surface">
      <pose>0 0 1.0 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.95</radius>
            <length>0.001</length>
          </cylinder>
        </geometry>
        <transparency>0.6</transparency>
        <material>
          <ambient>0.0 0.3 0.6 0.4</ambient>
          <diffuse>0.0 0.4 0.8 0.4</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
